# Mirrors the public targets of templates/major/*/BUILD.bazel. Keep in sync by
# hand when a target is added there.

_SINCE_17 = [
    "pg_combinebackup",
    "pg_combinebackup_bin",
    "pg_createsubscriber",
    "pg_createsubscriber_bin",
    "pg_walsummary",
    "pg_walsummary_bin",
]

[
    alias(
        name = name,
        actual = "@{repo}//:" + name,
        visibility = ["//visibility:public"],
    )
    for name in [
        "clusterdb",
        "clusterdb_bin",
        "createdb",
        "createdb_bin",
        "createuser",
        "createuser_bin",
        "dropdb",
        "dropdb_bin",
        "dropuser",
        "dropuser_bin",
        "initdb",
        "initdb_bin",
        "libpq",
        "pg_amcheck",
        "pg_amcheck_bin",
        "pg_archivecleanup",
        "pg_archivecleanup_bin",
        "pg_basebackup",
        "pg_basebackup_bin",
        "pg_checksums",
        "pg_checksums_bin",
        "pg_config",
        "pg_config_bin",
        "pg_controldata",
        "pg_controldata_bin",
        "pg_ctl",
        "pg_ctl_bin",
        "pg_dist",
        "pg_dump",
        "pg_dump_bin",
        "pg_dumpall",
        "pg_dumpall_bin",
        "pg_isready",
        "pg_isready_bin",
        "pg_receivewal",
        "pg_receivewal_bin",
        "pg_recvlogical",
        "pg_recvlogical_bin",
        "pg_resetwal",
        "pg_resetwal_bin",
        "pg_restore",
        "pg_restore_bin",
        "pg_rewind",
        "pg_rewind_bin",
        "pg_test_fsync",
        "pg_test_fsync_bin",
        "pg_test_timing",
        "pg_test_timing_bin",
        "pg_upgrade",
        "pg_upgrade_bin",
        "pg_verifybackup",
        "pg_verifybackup_bin",
        "pg_waldump",
        "pg_waldump_bin",
        "pgbench",
        "pgbench_bin",
        "pgcommon",
        "pgport",
        "postgres",
        "postgres_bin",
        "pq",
        "psql",
        "psql_bin",
        "reindexdb",
        "reindexdb_bin",
        "vacuumdb",
        "vacuumdb_bin",
    ] + (_SINCE_17 if {major} >= 17 else [])
]
